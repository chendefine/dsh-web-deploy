# DeepSeek Harness 容器部署配置。复制为 .env 后按需修改。
# 所有配置项均可调整；下列未注释值即推荐默认值。

# --- 运行模式 -----------------------------------------------------------
# AUTH_GATEWAY 决定实例拓扑与 HTTP 入口（仅接受 true / false）：
#   false -> 只启动 compose.yaml 中第一个 dsh runtime 实例，
#            并把该实例内置 nginx 的 80 端口直接发布到 HTTP_PORT；
#   true  -> 启动全部 dsh runtime 实例 + Authelia 认证，
#            并把 gateway 的 80 端口直接发布到 HTTP_PORT。
# HTTPS_EXPORT 只决定 task up/task update 是否自动启动内置 TLS；
#   它不影响 HTTP_PORT 的发布（HTTP 始终开放），也不会停止/删除已存在的 TLS 容器。
AUTH_GATEWAY=false
HTTPS_EXPORT=true

# --- 非特权用户 ---------------------------------------------------------
# 使用 `id -u` / `id -g` 查询。builder 与 dsh runtime 均以该 uid/gid 写入
# 源码产物、DSH_HOME 和 workspace；修改后需重新 task build。
HOST_UID=1000
HOST_GID=1000

# --- 域名与端口 ---------------------------------------------------------
# 认证模式下，业务与 Authelia 门户共用该域名。Authelia cookie 域要求至少含一个点，
# 不能使用裸 localhost；本机测试可用 dsh.localhost。内置 TLS 的证书也使用该域名。
DSH_DOMAIN=harness.deepseek.com

# HTTP_PORT 是唯一权威的宿主机 HTTP 发布端口，四种模式组合下始终开放：
# - AUTH_GATEWAY=false：发布在第一个 dsh runtime 实例上，浏览器可直接访问；
# - AUTH_GATEWAY=true ：发布在 gateway 上，主要供外部 TLS 终结器反代；
#   Authelia 4.39 要求浏览器经 HTTPS 登录，明文 HTTP_PORT 不能完成登录。
# 注意第一个 dsh runtime 实例同时是 AUTH_GATEWAY=false 模式的数据目录归属者。
HTTP_PORT=3080

# GATEWAY_PORT 已弃用。实现仅为旧 .env 暂时保留兼容回退；新配置不要再设置它。
#GATEWAY_PORT=3080

# 内置 TLS 的宿主机端口；使用外部 TLS 终结器时，也应填写其浏览器侧公开 HTTPS
# 端口，使 Authelia 在非 443 场景生成正确跳转 URL。不能与 HTTP_PORT 相同。
HTTPS_PORT=443

# --- 时区（可选） -------------------------------------------------------
# 不设置或留空时为 UTC，例如：Asia/Shanghai、Europe/Berlin。
#TZ=Asia/Shanghai

# --- Docker 网络（可选） ------------------------------------------------
# 设置名称即表示加入已存在的 external 网络；请先 docker network create <name>。
# Taskfile 会自动推导 *_EXTERNAL；若直接运行 docker compose，请同时显式设置 true。
# 注意 runtime 网络同时承载 dsh-http-entry 别名解析，入口与 TLS 必须同网。
#BUILDER_NETWORK=
#BUILDER_NETWORK_EXTERNAL=true
#RUN_NETWORK=
#RUN_NETWORK_EXTERNAL=true

# --- API key（可选） ----------------------------------------------------
# 环境变量 key 为所有 dsh 实例共享、只读且优先于 UI。若需要用户级隔离，建议登录后
# 在各实例 UI 中分别保存，使其落入各自独立的 DSH_HOME。
#DEEPSEEK_API_KEY=
