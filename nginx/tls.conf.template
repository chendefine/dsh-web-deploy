# =============================================================================
# dsh built-in TLS terminator.
#
# Browser --https--> tls --http + X-Forwarded-Proto:https--> selected HTTP entry
#
# The upstream is always the runtime-network alias dsh-http-entry. Which service owns
# that alias is decided by scripts/compose_mode.sh:
#   AUTH_GATEWAY=false -> first declared dsh runtime instance
#   AUTH_GATEWAY=true  -> gateway
# DSH_DOMAIN is rendered by the official nginx image's envsubst entrypoint; the alias is
# resolved at request time through Docker's embedded DNS, so switching AUTH_GATEWAY does
# not require recreating this container (a short 502 window during the switch is expected).
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Short validity keeps the mode-switch window bounded; `resolve` allows startup before the
# alias owner exists (requests then fail with 502 and recover once it appears).
resolver 127.0.0.11 valid=5s ipv6=off;

upstream selected_http_upstream {
    zone selected_http_upstream 64k;
    server dsh-http-entry:80 resolve;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DSH_DOMAIN};

    ssl_certificate     /etc/nginx/tls/${DSH_DOMAIN}.crt;
    ssl_certificate_key /etc/nginx/tls/${DSH_DOMAIN}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 100m;

    # TLS liveness is independent of upstream readiness. Business requests still return 502
    # while the selected dsh/auth block is absent and recover automatically when it starts.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://selected_http_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Preserve a non-standard public HTTPS port for Authelia redirects and rd URLs.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }
}
