# syntax=docker/dockerfile:1
# =============================================================================
# DeepSeek Harness (dsh) - RUNTIME 镜像
#
# 只含工具链与 nginx 反代, 从不 COPY 仓库: compose 把(builder 已安装构建的)
# 宿主机检出挂到 /app/dsh, 入口从中跑 `pnpm dsh web`。容器内栈:
#   dsh web(仅 127.0.0.1:3080, by design)
#     <- nginx :80 (HTTP)
# 与 builder 镜像同理烧入 .env 的 HOST_UID/HOST_GID 非特权用户 dsh, 入口经
# setpriv 把 'dsh web' 降到它(DSH_UID/DSH_GID env)。
# NODE_VERSION 须与 Dockerfile.builder 同步: 两镜像执行同一份挂载的 node_modules。
# =============================================================================

FROM debian:13.6

ARG NODE_VERSION=24.16.0

# 宿主机用户 uid/gid(compose 从 .env 传 build args, 同 Dockerfile.builder),
# 供第 5 步的非特权 dsh 账户; 改 .env 需重建本镜像(task build / update)。
ARG HOST_UID=1000
ARG HOST_GID=1000

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin DSH_HOME=/data/dsh-home

# ---------------------------------------------------------------------------
# 1. 工具链: agent 的开发工具 + 反代用 nginx。
#    Debian 包名映射: 'ssh'->openssh-client, 'netstat'->net-tools,
#    'pstree'->psmisc, 'ping'->iputils-ping, 'fd'->fd-find(二进制 fdfind),
#    'bat'->bat(二进制 batcat); fd/bat 软链出常用名, /usr/local/bin 在 PATH 首位。
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates tzdata curl git gnupg xz-utils build-essential \
  python3 python3-dev python3-pip python3-venv procps openssl unzip jq \
  ripgrep wget less nginx bubblewrap sudo \
  gh sqlite3 fd-find tree vim openssh-client zip fzf bat cmake \
  net-tools psmisc iputils-ping \
  && ln -s /usr/bin/fdfind /usr/local/bin/fd \
  && ln -s /usr/bin/batcat /usr/local/bin/bat \
  && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 2. Node.js + pnpm(锁定 package.json 的 "packageManager")
# ---------------------------------------------------------------------------
RUN arch="$(dpkg --print-architecture)"; case "$arch" in amd64) node_arch="x64";; arm64) node_arch="arm64";; *) echo "unsupported architecture" >&2; exit 1;; esac; curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" | tar -xJ -C /usr/local --strip-components=1; node --version; npm --version; npm install --global pnpm@11.7.0; pnpm --version

# ---------------------------------------------------------------------------
# 3. uv + ruff(静态单二进制, 按架构)
# ---------------------------------------------------------------------------
RUN arch="$(dpkg --print-architecture)"; case "$arch" in amd64) uv_arch="x86_64";; arm64) uv_arch="aarch64";; *) echo "unsupported architecture" >&2; exit 1;; esac; curl -fsSL "https://github.com/astral-sh/uv/releases/latest/download/uv-${uv_arch}-unknown-linux-gnu.tar.gz" | tar -xz -C /usr/local/bin --strip-components=1; curl -fsSL "https://github.com/astral-sh/ruff/releases/latest/download/ruff-${uv_arch}-unknown-linux-gnu.tar.gz" | tar -xz -C /usr/local/bin --strip-components=1; uv --version; ruff --version

# ---------------------------------------------------------------------------
# 4. 'dsh web'(127.0.0.1:3080)前的 nginx 反代: :80 HTTP, WS/SSE 透传。
#    配置由 ./nginx-dsh.conf(小 build context 的一部分)原样 COPY; 无运行时挂载,
#    改动需重建本镜像。
# ---------------------------------------------------------------------------
WORKDIR /app/dsh

RUN rm -f /etc/nginx/sites-enabled/default
COPY nginx-dsh.conf /etc/nginx/conf.d/dsh.conf
RUN nginx -t

# ---------------------------------------------------------------------------
# 5. 与 builder 同 uid/gid 的非特权 dsh 用户。入口在运行时以 setpriv 降到
#    DSH_UID:DSH_GID; 烧真实 passwd 条目让所有经密码库解析 uid 的工具
#    (node os.userInfo()、whoami、id -un...)都能找到用户而非 ENOENT。
#    debian:13 无 uid 1000 账户(不同于 builder 的 node 基础镜像), 无需清理,
#    uid/gid 相撞会直接构建失败。HOME 指向运行时挂载的 /data/workspace
#    (--home-dir; 目录由入口在启动时创建, 故 --no-create-home), uid->home 查询
#    与 `docker exec -u dsh` 都解析到同一真实目录而非幽灵 /home/dsh。
#    另授权 dsh 免密 sudo 到 root: drop-in 写入 /etc/sudoers.d/dsh(Debian 的
#    /etc/sudoers 已 @include 该目录), 440 权限, visudo -c 构建期校验语法。
# ---------------------------------------------------------------------------
RUN groupadd --gid "${HOST_GID}" dsh \
  && useradd --uid "${HOST_UID}" --gid "${HOST_GID}" --home-dir /data/workspace --no-create-home --shell /bin/bash dsh \
  && printf 'dsh ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/dsh \
  && chmod 440 /etc/sudoers.d/dsh \
  && visudo -c

# ---------------------------------------------------------------------------
# 6. 脚本: 入口(校验挂载检出、跑 'dsh web' + nginx、转发信号、任一退出即退)
#    + 它 exec 的降权启动器。均为小 ./build context 里的真实文件 COPY 进镜像
#    - 入口不在启动时写脚本。chmod 而非 COPY --chmod, 兼容任意 builder。
# ---------------------------------------------------------------------------
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
COPY dsh-run.sh /usr/local/bin/dsh-run.sh
RUN chmod +x /usr/local/bin/dsh-run.sh

# nginx 代理 SPA + API; dsh web 或 nginx 任一不响应即失败(容器转 unhealthy)。
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:80/ >/dev/null || exit 1

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
